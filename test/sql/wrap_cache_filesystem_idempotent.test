# name: test/sql/wrap_cache_filesystem_idempotent.test
# description: filesystem wrapping is volatile and safe to repeat.
# group: [sql]

require cache_httpfs

query TI
SELECT stability, has_side_effects FROM duckdb_functions()
WHERE function_name = 'cache_httpfs_wrap_cache_filesystem';
----
VOLATILE	true

# Planning must not wrap the filesystem before the query executes.
statement ok
EXPLAIN SELECT cache_httpfs_wrap_cache_filesystem('cache_httpfs_fake_filesystem');

query I
SELECT COUNT(*) FROM cache_httpfs_list_registered_filesystems()
WHERE registered_filesystems = 'cache_httpfs_fake_filesystem';
----
1

query I
SELECT cache_httpfs_wrap_cache_filesystem('cache_httpfs_fake_filesystem');
----
true

query I
SELECT cache_httpfs_wrap_cache_filesystem('cache_httpfs_fake_filesystem');
----
true

query I
SELECT COUNT(*) FROM cache_httpfs_list_registered_filesystems()
WHERE registered_filesystems = 'cache_httpfs_cache_httpfs_fake_filesystem';
----
1

query I
SELECT COUNT(*) FROM cache_httpfs_list_registered_filesystems()
WHERE registered_filesystems = 'cache_httpfs_fake_filesystem';
----
0

statement error
SELECT cache_httpfs_wrap_cache_filesystem('unregistered_filesystem');
----
Invalid Input Error: Filesystem unregistered_filesystem hasn't been registered yet!
